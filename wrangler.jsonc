{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-live-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stream-live-notifications",
      "database_id": "aabc2fa9-758f-4db4-84d6-c3b68c4534b2",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "APP_URL": "https://stream-live-notifications.lonanche.workers.dev",
    "MAX_RULES_PER_USER": "20",
  },
  "observability": {
    "enabled": true,
  },
}
